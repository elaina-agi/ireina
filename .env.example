# ─────────────────────────────────────────────────────────────────────────────
# Shirone Environment Variables Example
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to `.env` for local configuration.
# DO NOT commit your `.env` file containing secrets to version control.
# 本站用到的环境变量都可以写在根目录这一个 `.env` 里,但它只在你自己的电脑上生效:
# `.env` 不进仓库,部署平台读不到它,上线要用的值得在各平台的环境变量设置里再填一次。

# [Optional] Bilibili Anime Sync SESSDATA
# Required only when your Bilibili anime list is private and you run `pnpm anime:sync --provider bilibili`
# BILI_SESSDATA="your_bilibili_sessdata_here"

# [可选] 顶部横幅壁纸接口:你的 Cloudflare Worker 地址(配置见 src/wallpaper/config.js)
# 本地:在被忽略的 .env 中设置;部署:仅在托管平台的构建环境变量中填写,再重新构建
# 这里只保留注释示例,不要提交真实接口地址或个人展示名称
# PUBLIC_WALLPAPER_API="https://your-worker.your-subdomain.workers.dev"
# PUBLIC_WALLPAPER_NAME="自定义展示名称"
# PUBLIC_WALLPAPER_SOURCE="r2"
# API 填根地址,不要加 /api/random;未配置 API 不显示 r2 来源
# NAME 未配置沿用默认名称;SOURCE 未配置仍用 alcy,也可填 random / loli / paugram
# 这些 PUBLIC_ 配置不是秘密,上线后访客可在浏览器看到地址和名称

# [可选] Twikoo 评论（说明见 docs/twikoo.md）
# 评论后端在博客项目里（api/twikoo.js），数据存在 MongoDB 数据库。
# 
# ① 数据库连接地址（必填，否则评论接口启动失败）
#    MongoDB 连接串，如 mongodb+srv://user:pass@cluster.mongodb.net/dbname
#    通过 Vercel Marketplace 集成 MongoDB Atlas 时，这个变量会自动填好，不用手动设置
# MONGODB_URI="mongodb+srv://..."
#
# ② 评论后端自己的完整地址（必填，用于评论提交后的垃圾检测和邮件通知）
#    本地：http://localhost:4321/api/twikoo
#    上线：https://你的域名/api/twikoo
# TWIKOO_SELF_URL="https://blog.eriiagi.com/api/twikoo"
#
# ③ [可选] 本地调试时覆盖前端调用的后端地址（不填则用配置文件里写死的生产地址）
#    只在本地 `pnpm dev` 时生效，上线后这个变量不起作用
# PUBLIC_TWIKOO_BACKEND_URL="http://localhost:4321/api/twikoo"

# [可选] 友链申请(说明见 docs/friend-apply.md)
# 表单提交到本站自己的接口 /api/friend-apply:本地由 `pnpm dev` 直接提供,上线由 Vercel 运行。
#
# ① 表单开关。填了它,友链页才显示申请表单;不填就不显示。访客看得到,不是秘密。
#    本地:照抄下面这行(Cloudflare 官方的 Turnstile 测试 key,永远通过)
#    上线:在 Vercel 的环境变量里填你自己的 Turnstile site key
# PUBLIC_TURNSTILE_SITE_KEY="1x00000000000000000000AA"
#
# ② 接口用的四项。都是密钥 / 私人信息,不带 PUBLIC_ 前缀,不会进入网页。
#    本地:TURNSTILE_SECRET_KEY 照抄下面的官方测试 key(必须和上面的测试 site key 配对使用);
#         另外三项填你自己的。MAIL_FROM 的域名必须是在 Resend 验证过的那个。
#    上线:这四项也填在 Vercel 的环境变量里,其中 TURNSTILE_SECRET_KEY 要换成你自己的正式 secret
# TURNSTILE_SECRET_KEY="1x0000000000000000000000000000000AA"
# RESEND_API_KEY="re_xxxxxxxx"
# MAIL_FROM="友链申请 <noreply@send.example.com>"
# MAIL_TO="you@example.com"

# [Optional] Font Budget Overrides (bytes)
# FONT_MAX_TOTAL_BYTES=4194304
# FONT_MAX_FAMILY_BYTES=2097152

# ─────────────────────────────────────────────────────────────────────────────
# Content Separation (see docs/content-separation.md)
# ─────────────────────────────────────────────────────────────────────────────
# Leaving all of these unset keeps the theme in `local` mode: the repository's
# own content is used and `pnpm content:sync` is a no-op.

# [Optional] Local content repository checkout. Highest precedence; ideal for
# writing posts locally with `pnpm content:watch` running in a second terminal.
# CONTENT_DIR="../shirone-content"

# [Optional] Remote content repository. Used by hosts that build the code repo
# directly and therefore cannot check out a second repository themselves.
# Embed a token as `https://x-access-token:<TOKEN>@github.com/OWNER/REPO.git`
# when the content repository is private; it is redacted from all logs.
# CONTENT_REPO_URL="https://github.com/OWNER/shirone-content.git"
# CONTENT_REPO_REF="main"

# [Optional] Set to "false" to reuse the existing `.content-src/` working copy
# without fetching. Useful when a CI job already checked the content out.
# CONTENT_SYNC_PULL="true"

# [Optional] Set to "0" to force `local` mode even when the settings above or
# `shirone.content.json` are present.
# SHIRONE_CONTENT_SYNC="1"
